# JD Matcher — the only two build-time variables the frontend reads. Both are PUBLIC:
# they end up in the browser bundle. Never put a secret, internal hostname or any other
# VITE_* variable here (CI fails the deploy if one shows up in dist/).
#
# Copy to .env.local for local overrides.

# Public Gateway API. Leave empty in dev to use the mock: `npm run mock:api` (http://localhost:8787).
# Production (set by CI): https://jd-api.cuongle.technet.software
VITE_API_BASE=

# Cloudflare Turnstile site key (public by design). Empty in dev = bot check skipped.
# Production: GitHub Actions repository *variable* VITE_TURNSTILE_SITEKEY.
VITE_TURNSTILE_SITEKEY=
